{
  "name": "the-collegium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:ingress": "node dist/ingress/index.js",
    "start:fellow": "node dist/fellow/index.js",
    "start:forge": "node dist/forge/index.js",
    "console": "node dist/console.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --test dist-test/test/unit/arbitration.test.js dist-test/test/unit/commission.test.js dist-test/test/unit/redis-utils.test.js",
    "test:integration": "npm run test:build && node --test dist-test/test/integration/loop.test.js"
  },
  "dependencies": {
    "@slack/bolt": "^3.22.0",
    "@slack/web-api": "^7.10.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.5.0",
    "openai": "^4.77.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
