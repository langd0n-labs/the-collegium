SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token
REDIS_URL=redis://redis:6379
LLM_API_BASE=http://localhost:8001/v1
LLM_API_KEY=local-proxy-placeholder
LLM_MODEL=gpt-4.1
DELIBERATION_TURN_CAP=8

DS100_CHANNEL_ID=C0000000000
COLLEGIUM_MANIFEST=collegia/ds100.yaml
FORGE_WORKSPACE=/workspace

# Edge adapter (slack | file)
INGRESS_MODE=slack
# File-mode settings (required when INGRESS_MODE=file)
FILE_INGRESS_MODE=watch
INGRESS_FILE=./io/input.ndjson
EGRESS_FILE=./io/egress.log
REPLAY_SETTLE_MS=5000
# Console REPL channel/thread (used by npm run console)
CONSOLE_CHANNEL_ID=console
CONSOLE_THREAD_TS=
